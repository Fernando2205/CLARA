{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.12"
  },
  "deploy": {
    "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port $PORT",
    "aptPackages": [
      "libpango-1.0-0",
      "libpangocairo-1.0-0",
      "libcairo2",
      "libgdk-pixbuf2.0-0",
      "shared-mime-info",
      "fonts-liberation"
    ]
  }
}
